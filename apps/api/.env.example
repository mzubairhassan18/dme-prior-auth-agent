# Copy to .env and adjust for your environment.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dme?schema=public"
PORT=3001
RABBITMQ_URL=amqp://dme:dme@localhost:5672
AGENT_GRPC_URL=localhost:50051
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=localhost
# Hostname used in presigned URLs; defaults to MINIO_ENDPOINT.
# In Docker, keep MINIO_ENDPOINT=minio and set this to localhost.
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=dme
MINIO_SECRET_KEY=dme-local-secret
MINIO_BUCKET=dme-clinical-documents
