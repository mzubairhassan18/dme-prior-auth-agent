# Copy to .env.prod and adjust. Never commit the real file.
# docker compose --env-file .env.prod -f docker-compose.prod.yml ...

# Bind address for published ports (127.0.0.1 keeps infra off the LAN).
DME_BIND_ADDR=127.0.0.1

# Postgres
POSTGRES_PASSWORD=postgres

# RabbitMQ management: http://localhost:15672
RABBITMQ_USER=dme
RABBITMQ_PASSWORD=dme

# MinIO console: http://localhost:9001
MINIO_ROOT_USER=dme
MINIO_ROOT_PASSWORD=dme-local-secret
MINIO_BUCKET=dme-clinical-documents
# Hostname signed into browser download URLs (the S3 API port is published).
MINIO_PUBLIC_ENDPOINT=localhost

# Host Ollama by default. If you start the optional "llm" profile instead,
# set this to http://ollama:11434.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=phi4-mini
OLLAMA_EMBED_MODEL=nomic-embed-text

# Baked into the web bundle at image build time.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
